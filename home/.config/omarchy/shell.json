        { "id": "dki.quran-verse-of-the-day", "translation": "en.sahih", "rotationMode": "both" },
        { "id": "theme-picker" }, { "id": "robzolkos.github" },
        { "id": "omarchy.tailscale" }, { "id": "omarchy.bluetooth" },
        { "id": "omarchy.network" }, { "id": "omarchy.audio" },
        { "id": "omarchy.monitor" }, { "id": "omarchy.power", "showPercentage": true }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": { "lock": 300, "screensaver": 150 },
  "disabledPlugins": ["omarchy.notifications", "jankeesvw.notification-center"],
  "plugins": [
    { "id": "shell.settings" }, { "id": "io.github.dki.agentdeck" },

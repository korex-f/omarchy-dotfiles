        { "id": "njpatel.omapager" },
        { "id": "omarchy.keyboard-layout" },
        { "id": "omarchy.weather" },
        { "id": "io.github.dki.tugboat" },
        { "id": "io.github.dki.habit" },
        { "id": "io.github.huligabuliga.omasticky" },
        { "id": "dki.hijri-calendar", "format": "dddd, d MMMM yyyy · HH:mm" },
        { "id": "local.prayer-times" },
        { "id": "omarchy.system-update" }
      ],
      "left": [
        { "id": "omarchy.menu" },
        { "id": "omarchy.workspaces" },
        { "id": "crmne.active-window" }
      ],
      "right": [
        { "id": "djjeane.docker-monitor" }, { "id": "omarchy.tray" },
        { "id": "nixfred.burnbar" }, { "id": "omapdf.bar" },
        { "id": "com.omastorm.radar" }, { "id": "io.github.jondkinney.omapop" },
